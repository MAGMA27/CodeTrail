# Frontend: copy this value to apps/web/.env.local when overriding the default.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Per-submit/status-request timeout. Job execution is polled independently (default: 30 seconds).
NEXT_PUBLIC_GITHUB_REQUEST_TIMEOUT_MS=30000

# API: comma-separated browser origins allowed to call the local API.
CODETRAIL_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional comma-separated CIDRs allowed to call local-write APIs. Default empty; Compose derives this from CODETRAIL_COMPOSE_SUBNET.
CODETRAIL_TRUSTED_WRITE_NETWORKS=

# 默认关闭真实模型 Run。开启后会向配置的模型供应商发送已保存的 Session 消息和有界源码证据，并可能产生费用。
CODETRAIL_REAL_RUN_ENABLED=0

# Docker Compose private network. Check `ip route` on the host and choose a subnet that does not overlap any host route.
# The same value configures Docker IPAM and the API's trusted local-write client network.
CODETRAIL_COMPOSE_SUBNET=192.168.253.0/24

# API: JSON allow-list of repository IDs to absolute local roots.
# Example: {"timeout-demo":"D:/Dev/CodeTrail/fixtures/repos/timeout-demo"}
CODETRAIL_REPOSITORIES={}

# API: maximum number of fixture Runs executing in this process; overflow is retryable.
CODETRAIL_RUN_MAX_CONCURRENT_RUNS=2

# API: public GitHub repository import is enabled by default; set 0 to disable.
CODETRAIL_GITHUB_IMPORT_ENABLED=1
CODETRAIL_GITHUB_TOKEN=
# GitHub archive download timeouts in seconds; invalid values use these defaults.
CODETRAIL_GITHUB_DOWNLOAD_IDLE_TIMEOUT=30
CODETRAIL_GITHUB_DOWNLOAD_TIMEOUT=300
# Per-index source scan and parsing deadline for server-side indexing; positive seconds.
CODETRAIL_INDEX_TIMEOUT=240
# Maximum source snapshot size for indexing and freshness scans; positive bytes (default: 50 MiB).
CODETRAIL_INDEX_MAX_TOTAL_BYTES=52428800

# Background jobs: Redis enables the arq API/worker queue; without it, a process-local
# thread adapter runs the same durable SQLite jobs but cannot recover after process loss.
CODETRAIL_REDIS_URL=
CODETRAIL_WORKER_CONCURRENCY=2
CODETRAIL_JOB_MAX_RETRIES=2
CODETRAIL_JOB_ATTEMPT_TIMEOUT=600
CODETRAIL_JOB_TOTAL_TIMEOUT=1800
CODETRAIL_JOB_QUEUE_TIMEOUT=3600
CODETRAIL_JOB_LEASE_SECONDS=60

# MCP: independent opt-in for the GitHub import tool; also requires the API flag above.
CODETRAIL_MCP_GITHUB_IMPORT_ENABLED=0

# O2: semantic feature generation is available over HTTP; MCP generation is separately opt-in.

# O2 model credentials and endpoint: copy apps/api/config.example.json to the service data directory's config.json.
