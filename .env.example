# Frontend: copy this value to apps/web/.env.local when overriding the default.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API: comma-separated browser origins allowed to call the local API.
CODETRAIL_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API: JSON allow-list of repository IDs to absolute local roots.
# Example: {"timeout-demo":"D:/Dev/CodeTrail/fixtures/repos/timeout-demo"}
CODETRAIL_REPOSITORIES={}

# API: opt-in public GitHub repository import. Token is server-side only and optional.
CODETRAIL_GITHUB_IMPORT_ENABLED=0
CODETRAIL_GITHUB_TOKEN=

# MCP: independent opt-in for the GitHub import tool; also requires the API flag above.
CODETRAIL_MCP_GITHUB_IMPORT_ENABLED=0
